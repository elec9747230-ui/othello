@startuml classes_Othello
set namespaceSeparator none
class "AlphaBetaAI" as othello.ai.alphabeta.AlphaBetaAI {
  depth : int
  name : str
  select_move(state: GameState) -> Move
}
class "Board" as othello.core.board.Board {
  size : int
  cells() -> Iterator[tuple[int, int, Color]]
  copy() -> 'Board'
  in_bounds(r: int, c: int) -> bool
}
class "BoardView" as othello.ui.board_view.BoardView {
  canvas : Canvas
  is_animating : bool
  on_click : Callable[[int, int], None]
  size : int
  animate_move(new_board: Board, placed: Move, flipped: list[tuple[int, int]], on_done: Callable[[], None]) -> None
  render(board: Board, hints: Iterable[Move]) -> None
}
class "Color" as othello.core.board.Color {
  name
  opponent() -> 'Color'
}
class "GameScreen" as othello.ui.game_screen.GameScreen {
  ai : NoneType
  ai_color : Color | None
  app
  board_view
  config_data : dict
  history_text : Text
  score_label : Label
  state
  turn_label : Label
}
class "GameState" as othello.core.game.GameState {
  board
  current : BLACK, WHITE
  history : list[HistoryEntry]
  is_over() -> bool
  legal_moves() -> list[Move]
  must_pass() -> bool
  play(move: Move) -> None
  score() -> tuple[int, int]
  undo() -> None
  winner() -> Color | None
}
class "GreedyAI" as othello.ai.greedy.GreedyAI {
  name : str
  select_move(state: GameState) -> Move
}
class "HistoryEntry" as othello.core.game.HistoryEntry {
  board_before
  color_to_move
  move
}
class "MenuScreen" as othello.ui.menu_screen.MenuScreen {
  ai_frame : Labelframe
  ai_var : StringVar
  app
  color_frame : Labelframe
  color_var : StringVar
  mode_var : StringVar
  size_var : IntVar
}
class "MinimaxAI" as othello.ai.minimax.MinimaxAI {
  depth : int
  name : str
  select_move(state: GameState) -> Move
}
class "Move" as othello.core.board.Move {
  col : int
  is_pass : bool
  row : int
}
class "OthelloApp" as othello.ui.app.OthelloApp {
  current_screen : tk.Frame | None
  root : Tk
  show_game(config: dict[str, Any]) -> None
  show_menu() -> None
}
class "RandomAI" as othello.ai.random_ai.RandomAI {
  name : str
  select_move(state: GameState) -> Move
}
class "Strategy" as othello.ai.base.Strategy {
  name : str
  {abstract}select_move(state: GameState) -> Move
}
othello.ai.alphabeta.AlphaBetaAI --|> othello.ai.base.Strategy
othello.ai.greedy.GreedyAI --|> othello.ai.base.Strategy
othello.ai.minimax.MinimaxAI --|> othello.ai.base.Strategy
othello.ai.random_ai.RandomAI --|> othello.ai.base.Strategy
othello.core.game.HistoryEntry --> othello.core.board.Board : board_before
othello.core.game.HistoryEntry --> othello.core.board.Color : color_to_move
othello.core.game.HistoryEntry --> othello.core.board.Move : move
othello.ui.game_screen.GameScreen --> othello.core.game.GameState : state
othello.core.game.GameState --> othello.core.game.HistoryEntry : history
othello.ai.alphabeta.AlphaBetaAI --* othello.ui.game_screen.GameScreen : ai
othello.ai.greedy.GreedyAI --* othello.ui.game_screen.GameScreen : ai
othello.ai.minimax.MinimaxAI --* othello.ui.game_screen.GameScreen : ai
othello.ai.random_ai.RandomAI --* othello.ui.game_screen.GameScreen : ai
othello.core.board.Board --* othello.core.game.GameState : board
othello.ui.board_view.BoardView --* othello.ui.game_screen.GameScreen : board_view
@enduml
